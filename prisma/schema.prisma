generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PaymentStatus {
  DA_PAGARE
  COMPLETATO
  PAGATO_PARZIALMENTE
}

enum InvoiceStatus {
  NONE
  YES
  NO
  OK
  KO
  NON_PREVISTA
  IN_ATTESA
  INVIATA_SDI
  CONTESTAZIONE
  PARZIALE
  RICEVUTA
}

enum WorkspaceRole {
  OWNER
  ADMIN
  ACCOUNTANT
  VIEWER
}

enum ExpenseType {
  STANDARD
  VAT_SETTLEMENT
  COUNTER
}

enum SupplierSystemRole {
  VAT_SETTLEMENT
  COUNTER_MERCHANT
}

enum CustomerSystemRole {
  DEFAULT
  CASH_REGISTER
}

enum PaymentMethodSystemRole {
  CASH
}

enum IncomeType {
  STANDARD
  CASH_REGISTER
}

model User {
  id                  Int       @id @default(autoincrement())
  email               String    @unique
  passwordHash        String?
  googleId            String?   @unique
  googleEmailVerified Boolean   @default(false)
  emailVerifiedAt     DateTime?
  name                String?
  isActive            Boolean   @default(true)
  isSystemAdmin       Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  ownedWorkspaces         Workspace[]              @relation("WorkspaceOwner")
  memberships             WorkspaceMember[]
  sessions                AuthSession[]
  auditLogs               AuditLog[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
}

model Workspace {
  id        Int      @id @default(autoincrement())
  name      String
  ownerId   Int
  owner     User     @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members                            WorkspaceMember[]
  sessions                           AuthSession[]
  companies                          Company[]
  expenseCategories                  ExpenseCategory[]
  incomeCategories                   IncomeCategory[]
  incomeSalesChannels                IncomeSalesChannel[]
  banks                              Bank[]
  paymentMethods                     PaymentMethod[]
  suppliers                          Supplier[]
  customers                          Customer[]
  recurringExpenses                  RecurringExpense[]
  recurringIncomes                   RecurringIncome[]
  expenses                           Expense[]
  monthlyRevenues                    MonthlyRevenue[]
  incomes                            Income[]
  auditLogs                          AuditLog[]
  cashRegisterBankRules              CashRegisterBankRule[]
  vatSettlementCategoryId            Int?
  vatSettlementCategory              ExpenseCategory?       @relation("VatSettlementCategory", fields: [vatSettlementCategoryId], references: [id], onDelete: Restrict)
  cashRegisterIncomeCategoryId       Int?
  cashRegisterIncomeCategory         IncomeCategory?        @relation("CashRegisterIncomeCategory", fields: [cashRegisterIncomeCategoryId], references: [id], onDelete: Restrict)
  cashRegisterSalesChannelId         Int?
  cashRegisterSalesChannel           IncomeSalesChannel?    @relation("CashRegisterSalesChannel", fields: [cashRegisterSalesChannelId], references: [id], onDelete: Restrict)
  cashRegisterPrimaryPaymentMethodId Int?
  cashRegisterPrimaryPaymentMethod   PaymentMethod?         @relation("CashRegisterPrimaryPaymentMethod", fields: [cashRegisterPrimaryPaymentMethodId], references: [id], onDelete: Restrict)

  @@index([ownerId])
  @@index([vatSettlementCategoryId])
  @@index([cashRegisterIncomeCategoryId])
  @@index([cashRegisterSalesChannelId])
  @@index([cashRegisterPrimaryPaymentMethodId])
}

model WorkspaceMember {
  id          Int           @id @default(autoincrement())
  workspaceId Int
  userId      Int
  role        WorkspaceRole @default(VIEWER)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model AuthSession {
  id              Int      @id @default(autoincrement())
  tokenHash       String   @unique
  userId          Int
  workspaceId     Int?
  activeCompanyId Int?
  expiresAt       DateTime
  createdAt       DateTime @default(now())

  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace     Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  activeCompany Company?   @relation("ActiveCompanySession", fields: [activeCompanyId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([workspaceId])
  @@index([activeCompanyId])
  @@index([expiresAt])
}

model AuthThrottle {
  key          String    @id
  attempts     Int       @default(0)
  windowStart  DateTime
  blockedUntil DateTime?
  updatedAt    DateTime  @updatedAt

  @@index([blockedUntil])
  @@index([updatedAt])
}

model EmailVerificationToken {
  id        BigInt    @id @default(autoincrement())
  tokenHash String    @unique
  userId    Int
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        BigInt    @id @default(autoincrement())
  tokenHash String    @unique
  userId    Int
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model EmailOutbox {
  id          BigInt    @id @default(autoincrement())
  recipient   String
  subject     String
  textBody    String
  htmlBody    String
  status      String    @default("PENDING")
  attempts    Int       @default(0)
  nextAttempt DateTime  @default(now())
  lastError   String?
  sentAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, nextAttempt])
  @@index([createdAt])
}

model AuditLog {
  id          BigInt   @id @default(autoincrement())
  workspaceId Int
  userId      Int
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([workspaceId, createdAt])
  @@index([workspaceId, entityType, entityId])
  @@index([userId, createdAt])
}

model Company {
  id                Int                @id @default(autoincrement())
  code              String
  name              String
  legalName         String?
  vatNumber         String?
  taxCode           String?
  pec               String?
  sdiCode           String?
  address           String?
  isActive          Boolean            @default(true)
  isDefault         Boolean            @default(false)
  workspaceId       Int
  workspace         Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  primaryBankId     Int?
  primaryBank       Bank?              @relation("CompanyPrimaryBank", fields: [primaryBankId], references: [id], onDelete: SetNull)
  expenses          Expense[]
  incomes           Income[]
  recurringExpenses RecurringExpense[]
  recurringIncomes  RecurringIncome[]
  revenues          MonthlyRevenue[]
  activeSessions    AuthSession[]      @relation("ActiveCompanySession")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@unique([workspaceId, code])
  @@index([workspaceId])
  @@index([primaryBankId])
}

model ExpenseCategory {
  id                         Int                @id @default(autoincrement())
  code                       String
  name                       String
  icon                       String?
  workspaceId                Int?
  workspace                  Workspace?         @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  expenses                   Expense[]
  recurringExpenses          RecurringExpense[]
  vatSettlementForWorkspaces Workspace[]        @relation("VatSettlementCategory")
  defaultForSuppliers        Supplier[]         @relation("SupplierDefaultExpenseCategory")

  @@unique([workspaceId, code])
  @@index([workspaceId])
}

model IncomeCategory {
  id                        Int         @id @default(autoincrement())
  code                      String
  name                      String
  icon                      String?
  workspaceId               Int
  workspace                 Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  incomes                   Income[]
  recurringIncomes          RecurringIncome[]
  cashRegisterForWorkspaces Workspace[] @relation("CashRegisterIncomeCategory")

  @@unique([workspaceId, code])
  @@index([workspaceId])
}

model IncomeSalesChannel {
  id                        Int                    @id @default(autoincrement())
  code                      String
  name                      String
  icon                      String?
  sortOrder                 Int                    @default(0)
  isDefault                 Boolean                @default(false)
  isFallback                Boolean                @default(false)
  workspaceId               Int
  workspace                 Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  incomes                   Income[]
  recurringIncomes          RecurringIncome[]
  cashRegisterForWorkspaces Workspace[]            @relation("CashRegisterSalesChannel")
  cashRegisterBankRules     CashRegisterBankRule[]

  @@unique([workspaceId, code])
  @@index([workspaceId])
  @@index([workspaceId, sortOrder])
}

model Bank {
  id                         Int                    @id @default(autoincrement())
  name                       String
  icon                       String?
  isFallback                 Boolean                @default(false)
  workspaceId                Int?
  workspace                  Workspace?             @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  payments                   ExpensePayment[]
  recurringExpenses          RecurringExpense[]
  recurringIncomes           RecurringIncome[]
  incomeLegacyCredits        Income[]
  incomeCredits              IncomeCredit[]
  cashRegisterPaymentMethods PaymentMethod[]        @relation("CashRegisterDefaultBank")
  cashRegisterBankRules      CashRegisterBankRule[]
  primaryForCompanies        Company[]              @relation("CompanyPrimaryBank")

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model PaymentMethod {
  id                               Int                      @id @default(autoincrement())
  name                             String
  icon                             String?
  kind                             String                   @default("BOTH")
  isFallback                       Boolean                  @default(false)
  isExpenseDefault                 Boolean                  @default(false)
  isIncomeDefault                  Boolean                  @default(false)
  systemRole                       PaymentMethodSystemRole?
  workspaceId                      Int?
  workspace                        Workspace?               @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  incomePayments                   Income[]
  incomeCredits                    IncomeCredit[]
  expensePayments                  ExpensePayment[]
  recurringExpenses                RecurringExpense[]
  recurringIncomes                 RecurringIncome[]
  cashRegisterEnabled              Boolean                  @default(false)
  cashRegisterDefaultBankId        Int?
  cashRegisterDefaultBank          Bank?                    @relation("CashRegisterDefaultBank", fields: [cashRegisterDefaultBankId], references: [id], onDelete: Restrict)
  cashRegisterPrimaryForWorkspaces Workspace[]              @relation("CashRegisterPrimaryPaymentMethod")
  cashRegisterBankRules            CashRegisterBankRule[]

  @@unique([workspaceId, name])
  @@unique([workspaceId, systemRole])
  @@index([workspaceId])
  @@index([kind])
  @@index([cashRegisterDefaultBankId])
}

model CashRegisterBankRule {
  id              Int      @id @default(autoincrement())
  workspaceId     Int
  paymentMethodId Int
  salesChannelId  Int
  bankId          Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspace     Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  paymentMethod PaymentMethod      @relation(fields: [paymentMethodId], references: [id], onDelete: Cascade)
  salesChannel  IncomeSalesChannel @relation(fields: [salesChannelId], references: [id], onDelete: Cascade)
  bank          Bank               @relation(fields: [bankId], references: [id], onDelete: Restrict)

  @@unique([workspaceId, paymentMethodId, salesChannelId])
  @@index([paymentMethodId])
  @@index([salesChannelId])
  @@index([bankId])
}

model Supplier {
  id                       Int                 @id @default(autoincrement())
  businessName             String
  email                    String?
  vatNumber                String?
  iban                     String?
  pec                      String?
  taxCodeSdi               String?
  alias                    String?
  swift                    String?
  internalNotes            String?
  systemRole               SupplierSystemRole?
  workspaceId              Int?
  workspace                Workspace?          @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  defaultExpenseCategoryId Int?
  defaultExpenseCategory   ExpenseCategory?    @relation("SupplierDefaultExpenseCategory", fields: [defaultExpenseCategoryId], references: [id], onDelete: SetNull)
  expenses                 Expense[]
  recurringExpenses        RecurringExpense[]
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt

  @@unique([workspaceId, systemRole])
  @@index([businessName])
  @@index([alias])
  @@index([workspaceId])
  @@index([defaultExpenseCategoryId])
}

model Customer {
  id            Int                 @id @default(autoincrement())
  businessName  String
  alias         String?
  email         String?
  vatNumber     String?
  taxCodeSdi    String?
  pec           String?
  iban          String?
  swift         String?
  internalNotes String?
  systemRole    CustomerSystemRole?
  workspaceId   Int
  workspace     Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  incomes       Income[]
  recurringIncomes RecurringIncome[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@unique([workspaceId, systemRole])
  @@index([businessName])
  @@index([alias])
  @@index([workspaceId])
}

model RecurringExpense {
  id                   Int              @id @default(autoincrement())
  workspaceId          Int?
  workspace            Workspace?       @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  companyId            Int
  company              Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  startDate            DateTime
  cadence              String
  dueDay               Int?
  dueMonth             Int?
  isAutomaticPayment   Boolean          @default(false)
  billingPeriodMode    String           @default("SAME_MONTH")
  billingMonth         Int?
  merchant             String
  supplierId           Int?
  supplier             Supplier?        @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  categoryId           Int?
  category             ExpenseCategory? @relation(fields: [categoryId], references: [id])
  description          String?
  amount               Decimal          @db.Decimal(12, 2)
  vatRate              Decimal          @default(22) @db.Decimal(5, 2)
  isDeclared           Boolean          @default(true)
  hasElectronicInvoice Boolean          @default(true)
  paymentMethodId      Int?
  paymentMethod        PaymentMethod?   @relation(fields: [paymentMethodId], references: [id])
  bankId               Int?
  bank                 Bank?            @relation(fields: [bankId], references: [id])
  notes                String?
  isActive             Boolean          @default(true)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  generatedExpenses Expense[]

  @@index([workspaceId])
  @@index([workspaceId, companyId])
  @@index([startDate])
  @@index([supplierId])
  @@index([isActive])
  @@index([paymentMethodId])
}

model RecurringIncome {
  id                   Int                @id @default(autoincrement())
  workspaceId          Int
  workspace            Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  companyId            Int
  company              Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  startDate            DateTime
  cadence              String
  creditDay            Int?
  creditMonth          Int?
  isAutomaticCredit    Boolean             @default(false)
  billingPeriodMode    String              @default("SAME_MONTH")
  billingMonth         Int?
  customerId           Int?
  customer             Customer?           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  salesChannelId       Int
  salesChannel         IncomeSalesChannel  @relation(fields: [salesChannelId], references: [id], onDelete: Restrict)
  incomeCategoryId     Int
  incomeCategory       IncomeCategory      @relation(fields: [incomeCategoryId], references: [id], onDelete: Restrict)
  description          String
  amount               Decimal             @db.Decimal(12, 2)
  vatRate              Decimal             @default(22) @db.Decimal(5, 2)
  isFiscal             Boolean             @default(true)
  paymentMethodId      Int?
  paymentMethod        PaymentMethod?       @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)
  bankId               Int?
  bank                 Bank?                @relation(fields: [bankId], references: [id], onDelete: Restrict)
  notes                String?
  isActive             Boolean              @default(true)
  generatedIncomes     Income[]
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@index([workspaceId])
  @@index([workspaceId, companyId])
  @@index([startDate])
  @@index([customerId])
  @@index([isActive])
}

model Expense {
  id                      Int              @id @default(autoincrement())
  workspaceId             Int?
  workspace               Workspace?       @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  receivedDate            DateTime?
  merchant                String
  supplierId              Int
  supplier                Supplier         @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  categoryId              Int?
  category                ExpenseCategory? @relation(fields: [categoryId], references: [id])
  description             String?
  amount                  Decimal          @db.Decimal(12, 2)
  expenseType             ExpenseType      @default(STANDARD)
  paymentDate             DateTime?
  dueDate                 DateTime?
  vatRate                 Decimal          @default(22) @db.Decimal(5, 2)
  isComplete              Boolean          @default(false)
  isDeclared              Boolean          @default(true)
  hasElectronicInvoice    Boolean          @default(true)
  isRecurring             Boolean          @default(false)
  isAutomaticPayment      Boolean          @default(false)
  invoiceStatus           InvoiceStatus    @default(IN_ATTESA)
  companyId               Int
  company                 Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  month                   Int
  year                    Int
  notes                   String?
  counterExpenseRequestId String?

  paymentStatus       PaymentStatus @default(DA_PAGARE)
  paidAmount          Decimal       @default(0) @db.Decimal(12, 2)
  invoiceDocumentPath String?

  payments    ExpensePayment[]
  attachments ExpenseAttachment[]

  recurringExpenseId        Int?
  recurringExpense          RecurringExpense? @relation(fields: [recurringExpenseId], references: [id], onDelete: SetNull)
  recurringExpensePeriodKey String?
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt

  @@unique([recurringExpenseId, recurringExpensePeriodKey])
  @@unique([workspaceId, counterExpenseRequestId])
  @@index([workspaceId])
  @@index([workspaceId, companyId])
  @@index([year, month])
  @@index([merchant])
  @@index([expenseType])
}

model ExpensePayment {
  id              Int           @id @default(autoincrement())
  expenseId       Int
  expense         Expense       @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  paymentDate     DateTime?
  paymentMethodId Int
  paymentMethod   PaymentMethod @relation(fields: [paymentMethodId], references: [id])
  bankId          Int?
  bank            Bank?         @relation(fields: [bankId], references: [id])
  amount          Decimal       @db.Decimal(12, 2)
  createdAt       DateTime      @default(now())

  @@index([expenseId])
  @@index([paymentDate])
  @@index([paymentMethodId])
}

model ExpenseAttachment {
  id           Int      @id @default(autoincrement())
  expenseId    Int
  expense      Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  originalName String
  path         String
  mimeType     String?
  sizeBytes    Int?
  createdAt    DateTime @default(now())

  @@index([expenseId])
}

model MonthlyRevenue {
  id              Int        @id @default(autoincrement())
  workspaceId     Int?
  workspace       Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  companyId       Int
  company         Company    @relation(fields: [companyId], references: [id])
  month           Int
  year            Int
  webAmount       Decimal    @default(0) @db.Decimal(12, 2)
  shopAmount      Decimal    @default(0) @db.Decimal(12, 2)
  noInvoiceAmount Decimal    @default(0) @db.Decimal(12, 2)
  totalOrders     Int?
  inps            Decimal    @default(0) @db.Decimal(12, 2)
  accountant      Decimal    @default(0) @db.Decimal(12, 2)
  tari            Decimal    @default(0) @db.Decimal(12, 2)
  taxRate         Decimal    @default(28) @db.Decimal(5, 2)
  notes           String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@unique([companyId, year, month])
  @@index([workspaceId])
  @@index([year, month])
}

model Income {
  id                    Int                @id @default(autoincrement())
  workspaceId           Int?
  workspace             Workspace?         @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  companyId             Int
  company               Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  customerId            Int?
  customer              Customer?          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  salesChannelId        Int
  salesChannelRef       IncomeSalesChannel @relation(fields: [salesChannelId], references: [id], onDelete: Restrict)
  incomeCategoryId      Int
  incomeCategory        IncomeCategory     @relation(fields: [incomeCategoryId], references: [id], onDelete: Restrict)
  description           String?
  amount                Decimal            @db.Decimal(12, 2)
  paymentMethodId       Int
  paymentMethodRef      PaymentMethod      @relation(fields: [paymentMethodId], references: [id])
  creditBankId          Int
  creditBank            Bank               @relation(fields: [creditBankId], references: [id])
  orderDate             DateTime?
  creditDate            DateTime
  expectedCreditDate    DateTime?
  isCredited            Boolean            @default(true)
  billingMonth          Int                @default(1)
  billingYear           Int                @default(2026)
  isFiscal              Boolean            @default(true)
  invoiceStatus         String?
  vatRate               Decimal            @default(22) @db.Decimal(5, 2)
  notes                 String?
  incomeType            IncomeType         @default(STANDARD)
  cashRegisterRequestId String?
  credits               IncomeCredit[]
  recurringIncomeId     Int?
  recurringIncome       RecurringIncome? @relation(fields: [recurringIncomeId], references: [id], onDelete: SetNull)
  recurringIncomePeriodKey String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@unique([workspaceId, cashRegisterRequestId])
  @@unique([recurringIncomeId, recurringIncomePeriodKey])
  @@index([workspaceId])
  @@index([workspaceId, companyId])
  @@index([customerId])
  @@index([orderDate])
  @@index([creditDate])
  @@index([billingYear, billingMonth])
  @@index([salesChannelId])
  @@index([incomeCategoryId])
  @@index([isFiscal])
  @@index([paymentMethodId])
  @@index([creditBankId])
  @@index([incomeType])
}

model IncomeCredit {
  id              Int           @id @default(autoincrement())
  incomeId        Int
  income          Income        @relation(fields: [incomeId], references: [id], onDelete: Cascade)
  creditDate      DateTime
  paymentMethodId Int
  paymentMethod   PaymentMethod @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)
  bankId          Int
  bank            Bank          @relation(fields: [bankId], references: [id], onDelete: Restrict)
  amount          Decimal       @db.Decimal(12, 2)
  sourceKey       String?       @unique
  createdAt       DateTime      @default(now())

  @@index([incomeId])
  @@index([creditDate])
  @@index([paymentMethodId])
  @@index([bankId])
}
