generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CompanyCode {
  HM
  TS
  OTHER
}

enum PaymentStatus {
  DA_PAGARE
  COMPLETATO
  PAGATO_PARZIALMENTE
}

enum InvoiceStatus {
  NONE
  YES
  NO
  OK
  KO
  NON_PREVISTA
  IN_ATTESA
  INVIATA_SDI
  CONTESTAZIONE
  RICEVUTA
}

enum WorkspaceRole {
  OWNER
  ADMIN
  ACCOUNTANT
  VIEWER
}

enum ExpenseType {
  STANDARD
  VAT_SETTLEMENT
}

enum SupplierSystemRole {
  VAT_SETTLEMENT
}

enum CustomerSystemRole {
  DEFAULT
  CASH_REGISTER
}

enum PaymentMethodSystemRole {
  CASH
}

enum IncomeType {
  STANDARD
  CASH_REGISTER
}

model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  passwordHash String?
  googleId     String?   @unique
  googleEmailVerified Boolean @default(false)
  emailVerifiedAt DateTime?
  name         String?
  isActive     Boolean   @default(true)
  isSystemAdmin Boolean  @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  ownedWorkspaces Workspace[]       @relation("WorkspaceOwner")
  memberships     WorkspaceMember[]
  sessions        AuthSession[]
  auditLogs       AuditLog[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens PasswordResetToken[]
}

model Workspace {
  id        Int      @id @default(autoincrement())
  name      String
  ownerId   Int
  owner     User     @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members            WorkspaceMember[]
  sessions           AuthSession[]
  companies          Company[]
  expenseCategories  ExpenseCategory[]
  incomeCategories   IncomeCategory[]
  incomeSalesChannels IncomeSalesChannel[]
  banks              Bank[]
  paymentMethods     PaymentMethod[]
  suppliers          Supplier[]
  customers          Customer[]
  recurringExpenses  RecurringExpense[]
  expenses           Expense[]
  monthlyRevenues    MonthlyRevenue[]
  incomes            Income[]
  auditLogs          AuditLog[]
  cashRegisterBankRules CashRegisterBankRule[]
  vatSettlementCategoryId Int?
  vatSettlementCategory ExpenseCategory? @relation("VatSettlementCategory", fields: [vatSettlementCategoryId], references: [id], onDelete: Restrict)
  cashRegisterIncomeCategoryId Int?
  cashRegisterIncomeCategory IncomeCategory? @relation("CashRegisterIncomeCategory", fields: [cashRegisterIncomeCategoryId], references: [id], onDelete: Restrict)
  cashRegisterSalesChannelId Int?
  cashRegisterSalesChannel IncomeSalesChannel? @relation("CashRegisterSalesChannel", fields: [cashRegisterSalesChannelId], references: [id], onDelete: Restrict)
  cashRegisterPrimaryPaymentMethodId Int?
  cashRegisterPrimaryPaymentMethod PaymentMethod? @relation("CashRegisterPrimaryPaymentMethod", fields: [cashRegisterPrimaryPaymentMethodId], references: [id], onDelete: Restrict)

  @@index([ownerId])
  @@index([vatSettlementCategoryId])
  @@index([cashRegisterIncomeCategoryId])
  @@index([cashRegisterSalesChannelId])
  @@index([cashRegisterPrimaryPaymentMethodId])
}

model WorkspaceMember {
  id          Int           @id @default(autoincrement())
  workspaceId Int
  userId      Int
  role        WorkspaceRole @default(VIEWER)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model AuthSession {
  id          Int       @id @default(autoincrement())
  tokenHash   String    @unique
  userId      Int
  workspaceId Int?
  expiresAt   DateTime
  createdAt   DateTime  @default(now())

  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([workspaceId])
  @@index([expiresAt])
}

model AuthThrottle {
  key          String    @id
  attempts     Int       @default(0)
  windowStart  DateTime
  blockedUntil DateTime?
  updatedAt    DateTime  @updatedAt

  @@index([blockedUntil])
  @@index([updatedAt])
}

model EmailVerificationToken {
  id        BigInt    @id @default(autoincrement())
  tokenHash String    @unique
  userId    Int
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        BigInt    @id @default(autoincrement())
  tokenHash String    @unique
  userId    Int
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model EmailOutbox {
  id          BigInt    @id @default(autoincrement())
  recipient   String
  subject     String
  textBody    String
  htmlBody    String
  status      String    @default("PENDING")
  attempts    Int       @default(0)
  nextAttempt DateTime  @default(now())
  lastError   String?
  sentAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, nextAttempt])
  @@index([createdAt])
}

model AuditLog {
  id          BigInt    @id @default(autoincrement())
  workspaceId Int
  userId      Int
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([workspaceId, createdAt])
  @@index([workspaceId, entityType, entityId])
  @@index([userId, createdAt])
}

model Company {
  id        Int       @id @default(autoincrement())
  code      CompanyCode @unique
  name      String
  workspaceId Int?
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  expenses  Expense[]
  revenues  MonthlyRevenue[]
  createdAt DateTime @default(now())

  @@index([workspaceId])
}

model ExpenseCategory {
  id        Int       @id @default(autoincrement())
  code      String
  name      String
  icon      String?
  workspaceId Int?
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  expenses  Expense[]
  recurringExpenses RecurringExpense[]
  vatSettlementForWorkspaces Workspace[] @relation("VatSettlementCategory")
  defaultForSuppliers Supplier[] @relation("SupplierDefaultExpenseCategory")

  @@unique([workspaceId, code])
  @@index([workspaceId])
}

model IncomeCategory {
  id          Int       @id @default(autoincrement())
  code        String
  name        String
  icon        String?
  workspaceId Int
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  incomes     Income[]
  cashRegisterForWorkspaces Workspace[] @relation("CashRegisterIncomeCategory")

  @@unique([workspaceId, code])
  @@index([workspaceId])
}

model IncomeSalesChannel {
  id          Int       @id @default(autoincrement())
  code        String
  name        String
  icon        String?
  sortOrder   Int       @default(0)
  workspaceId Int
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  incomes     Income[]
  cashRegisterForWorkspaces Workspace[] @relation("CashRegisterSalesChannel")
  cashRegisterBankRules CashRegisterBankRule[]

  @@unique([workspaceId, code])
  @@index([workspaceId])
  @@index([workspaceId, sortOrder])
}

model Bank {
  id        Int       @id @default(autoincrement())
  name      String
  icon      String?
  isFallback Boolean @default(false)
  workspaceId Int?
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  payments  ExpensePayment[]
  recurringExpenses RecurringExpense[]
  incomeCredits Income[]
  cashRegisterPaymentMethods PaymentMethod[] @relation("CashRegisterDefaultBank")
  cashRegisterBankRules CashRegisterBankRule[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model PaymentMethod {
  id        Int       @id @default(autoincrement())
  name      String
  icon      String?
  kind      String    @default("BOTH")
  isFallback Boolean  @default(false)
  systemRole PaymentMethodSystemRole?
  workspaceId Int?
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  incomePayments Income[]
  expensePayments ExpensePayment[]
  recurringExpenses RecurringExpense[]
  cashRegisterEnabled Boolean @default(false)
  cashRegisterDefaultBankId Int?
  cashRegisterDefaultBank Bank? @relation("CashRegisterDefaultBank", fields: [cashRegisterDefaultBankId], references: [id], onDelete: Restrict)
  cashRegisterPrimaryForWorkspaces Workspace[] @relation("CashRegisterPrimaryPaymentMethod")
  cashRegisterBankRules CashRegisterBankRule[]

  @@unique([workspaceId, name])
  @@unique([workspaceId, systemRole])
  @@index([workspaceId])
  @@index([kind])
  @@index([cashRegisterDefaultBankId])
}

model CashRegisterBankRule {
  id              Int      @id @default(autoincrement())
  workspaceId     Int
  paymentMethodId Int
  salesChannelId  Int
  bankId          Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspace     Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  paymentMethod PaymentMethod      @relation(fields: [paymentMethodId], references: [id], onDelete: Cascade)
  salesChannel  IncomeSalesChannel @relation(fields: [salesChannelId], references: [id], onDelete: Cascade)
  bank          Bank               @relation(fields: [bankId], references: [id], onDelete: Restrict)

  @@unique([workspaceId, paymentMethodId, salesChannelId])
  @@index([paymentMethodId])
  @@index([salesChannelId])
  @@index([bankId])
}

model Supplier {
  id             Int       @id @default(autoincrement())
  businessName   String
  email          String?
  vatNumber      String?
  iban           String?
  pec            String?
  taxCodeSdi     String?
  alias          String?
  internalNotes  String?
  systemRole     SupplierSystemRole?
  workspaceId    Int?
  workspace      Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  defaultExpenseCategoryId Int?
  defaultExpenseCategory ExpenseCategory? @relation("SupplierDefaultExpenseCategory", fields: [defaultExpenseCategoryId], references: [id], onDelete: SetNull)
  expenses       Expense[]
  recurringExpenses RecurringExpense[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([businessName])
  @@index([alias])
  @@index([workspaceId])
  @@index([defaultExpenseCategoryId])
  @@unique([workspaceId, systemRole])
}

model Customer {
  id            Int       @id @default(autoincrement())
  businessName  String
  alias         String?
  email         String?
  vatNumber     String?
  taxCodeSdi    String?
  pec           String?
  iban          String?
  swift         String?
  internalNotes String?
  systemRole    CustomerSystemRole?
  workspaceId   Int
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  incomes       Income[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([businessName])
  @@index([alias])
  @@index([workspaceId])
  @@unique([workspaceId, systemRole])
}

model RecurringExpense {
  id                   Int       @id @default(autoincrement())
  workspaceId          Int?
  workspace            Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  startDate            DateTime
  cadence              String
  dueDay               Int?
  dueMonth             Int?
  isAutomaticPayment   Boolean   @default(false)
  billingPeriodMode    String    @default("SAME_MONTH")
  billingMonth         Int?
  merchant             String
  supplierId           Int?
  supplier             Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  categoryId           Int?
  category             ExpenseCategory? @relation(fields: [categoryId], references: [id])
  description          String?
  amount               Decimal   @db.Decimal(12, 2)
  vatRate              Decimal   @db.Decimal(5, 2) @default(22)
  isDeclared           Boolean   @default(true)
  hasElectronicInvoice Boolean   @default(true)
  paymentMethodId      Int?
  paymentMethod        PaymentMethod? @relation(fields: [paymentMethodId], references: [id])
  bankId               Int?
  bank                 Bank?     @relation(fields: [bankId], references: [id])
  notes                String?
  isActive             Boolean   @default(true)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  generatedExpenses    Expense[]
  @@index([workspaceId])
  @@index([startDate])
  @@index([supplierId])
  @@index([isActive])
  @@index([paymentMethodId])
}


model Expense {
  id                    Int       @id @default(autoincrement())
  workspaceId           Int?
  workspace             Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  receivedDate          DateTime?
  merchant              String
  supplierId            Int
  supplier              Supplier  @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  categoryId            Int?
  category              ExpenseCategory? @relation(fields: [categoryId], references: [id])
  description           String?
  amount                Decimal   @db.Decimal(12, 2)
  expenseType           ExpenseType @default(STANDARD)
  paymentDate           DateTime?
  dueDate               DateTime?
  vatRate               Decimal   @db.Decimal(5, 2) @default(22)
  isComplete            Boolean   @default(false)
  isDeclared            Boolean   @default(true)
  hasElectronicInvoice  Boolean   @default(true)
  isRecurring          Boolean   @default(false)
  isAutomaticPayment   Boolean   @default(false)
  invoiceStatus         InvoiceStatus @default(IN_ATTESA)
  companyId             Int?
  company               Company?  @relation(fields: [companyId], references: [id])
  month                 Int
  year                  Int
  notes                 String?

  paymentStatus         PaymentStatus @default(DA_PAGARE)
  paidAmount            Decimal   @db.Decimal(12, 2) @default(0)
  invoiceDocumentPath   String?

  payments              ExpensePayment[]
  attachments           ExpenseAttachment[]

  recurringExpenseId    Int?
  recurringExpense      RecurringExpense? @relation(fields: [recurringExpenseId], references: [id], onDelete: SetNull)
  recurringExpensePeriodKey String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([recurringExpenseId, recurringExpensePeriodKey])
  @@index([workspaceId])
  @@index([year, month])
  @@index([merchant])
  @@index([expenseType])
}

model ExpensePayment {
  id          Int       @id @default(autoincrement())
  expenseId   Int
  expense     Expense   @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  paymentDate DateTime?
  paymentMethodId Int
  paymentMethod PaymentMethod @relation(fields: [paymentMethodId], references: [id])
  bankId      Int?
  bank        Bank?     @relation(fields: [bankId], references: [id])
  amount      Decimal   @db.Decimal(12, 2)
  createdAt   DateTime  @default(now())

  @@index([expenseId])
  @@index([paymentDate])
  @@index([paymentMethodId])
}

model ExpenseAttachment {
  id           Int       @id @default(autoincrement())
  expenseId    Int
  expense      Expense   @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  originalName String
  path         String
  mimeType     String?
  sizeBytes    Int?
  createdAt    DateTime  @default(now())

  @@index([expenseId])
}

model MonthlyRevenue {
  id              Int       @id @default(autoincrement())
  workspaceId     Int?
  workspace       Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  companyId       Int
  company         Company   @relation(fields: [companyId], references: [id])
  month           Int
  year            Int
  webAmount       Decimal   @db.Decimal(12, 2) @default(0)
  shopAmount      Decimal   @db.Decimal(12, 2) @default(0)
  noInvoiceAmount Decimal   @db.Decimal(12, 2) @default(0)
  totalOrders     Int?
  inps            Decimal   @db.Decimal(12, 2) @default(0)
  accountant      Decimal   @db.Decimal(12, 2) @default(0)
  tari            Decimal   @db.Decimal(12, 2) @default(0)
  taxRate         Decimal   @db.Decimal(5, 2) @default(28)
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([companyId, year, month])
  @@index([workspaceId])
  @@index([year, month])
}


model Income {
  id              Int       @id @default(autoincrement())
  workspaceId     Int?
  workspace       Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  customerId      Int?
  customer        Customer? @relation(fields: [customerId], references: [id], onDelete: Restrict)
  salesChannelId  Int
  salesChannelRef IncomeSalesChannel @relation(fields: [salesChannelId], references: [id], onDelete: Restrict)
  incomeCategoryId Int
  incomeCategory  IncomeCategory @relation(fields: [incomeCategoryId], references: [id], onDelete: Restrict)
  description     String?
  amount          Decimal   @db.Decimal(12, 2)
  paymentMethodId Int
  paymentMethodRef PaymentMethod @relation(fields: [paymentMethodId], references: [id])
  creditBankId    Int
  creditBank      Bank     @relation(fields: [creditBankId], references: [id])
  orderDate       DateTime?
  creditDate      DateTime
  isCredited      Boolean   @default(true)
  billingMonth    Int       @default(1)
  billingYear     Int       @default(2026)
  isFiscal        Boolean   @default(true)
  invoiceStatus   String?
  vatRate         Decimal   @db.Decimal(5, 2) @default(22)
  notes           String?
  incomeType      IncomeType @default(STANDARD)
  cashRegisterRequestId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([workspaceId])
  @@index([customerId])
  @@index([orderDate])
  @@index([creditDate])
  @@index([billingYear, billingMonth])
  @@index([salesChannelId])
  @@index([incomeCategoryId])
  @@index([isFiscal])
  @@index([paymentMethodId])
  @@index([creditBankId])
  @@index([incomeType])
  @@unique([workspaceId, cashRegisterRequestId])
}
