{
  "name": "tabularium",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "node --import tsx --test tests/*.test.ts",
    "verify": "npm run db:validate && npm run typecheck && npm test && npm run build",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev --name init",
    "db:deploy": "bash scripts/deploy-migrations.sh",
    "db:seed": "prisma generate && tsx prisma/seed.ts",
    "import:excel": "tsx scripts/import-excel.ts",
    "db:push": "prisma db push && prisma generate",
    "db:reset-local": "prisma migrate reset --force && prisma generate",
    "db:sync": "prisma db push && prisma generate",
    "db:backfill-vat-settlement": "node scripts/backfill-vat-settlement-defaults.js",
    "db:backfill-income-order-dates": "node scripts/backfill-income-order-dates.js",
    "db:backfill-customers": "node scripts/backfill-customers.js",
    "db:migrate:recurring-automatic-payment": "tsx scripts/migrate-recurring-automatic-payment.ts",
    "import:expenses": "tsx scripts/import-expenses.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.9.0",
    "dotenv": "^16.6.1",
    "next": "^15.5.21",
    "nodemailer": "^9.0.3",
    "pg": "^8.16.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.15.5",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "prisma": "^7.9.0",
    "sass": "^1.101.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.18",
      "sharp": "0.35.0"
    }
  },
  "type": "module"
}
